BOT_TOKEN=your_bot_token
DB_PATH=/opt/tg-quiz-bot/quiz_bot.sqlite3
ADMIN_USERNAMES=admin_username

# Team registration data (personal data - keep only in .env)
TEAM_NAME=My Team
AMRA_TEAM_NAME=
TEAM_CAPTAIN_NAME=
TEAM_CAPTAIN_PHONE=
TEAM_CAPTAIN_EMAIL=
TEAM_REGISTRATION_COMMENT=

# Optional QuizPlease promo (0 = disabled)
QUIZPLEASE_PROMO_CODE=
QUIZPLEASE_PROMO_ID=0
QUIZPLEASE_PROMO_END_DATE=1970-01-01

# Optional backup settings
BACKUP_DIR=/opt/tg-quiz-bot/backups
RETENTION_DAYS=14

# Optional cloud backup via rclone (example: b2:quiz-bot-backups)
RCLONE_REMOTE=

# Optional fallback backup to Telegram
SEND_TO_TELEGRAM_BACKUP=0
BACKUP_CHAT_ID=
